# ------------------------------------------------------------
# Copy this file to ".env" (same folder) and fill in YOUR values.
# Never upload .env to GitHub. It is already in .gitignore.
# ------------------------------------------------------------

# PostgreSQL connection: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/smartstock

# A long random secret used to sign login tokens (at least 32 characters).
# Make one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_secret_at_least_32_characters

# How long a login lasts
JWT_EXPIRES_IN=8h

# Port for the API server
PORT=5000

# Address of the React app (allowed by CORS)
CLIENT_ORIGIN=http://localhost:5173

# Time zone used for "today" and "this month" in reports
APP_TIMEZONE=Asia/Bangkok

# Needed later for the AI Business Assistant (step 10). Leave empty for now.
OPENAI_API_KEY=
